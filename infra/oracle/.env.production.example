# Copy to .env.production on the Oracle VM. Never commit real secrets.
POSTGRES_DB=nexa
POSTGRES_USER=nexa_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=https://app.springnexa.in
NEXT_PUBLIC_API_URL=https://api.springnexa.in
